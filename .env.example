# Maman local environment contract.
# Copy via: bash scripts/bootstrap-local-env.sh
# The bootstrap script generates strong local-only secrets for every <generated> value.
# This file must never contain a usable secret.

# --- Required for local demo ---

# development | test | production
NODE_ENV=development

# dev | workos. The API refuses to start with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev

# demo | anthropic. demo requires no API key and is fully deterministic.
MODEL_PROVIDER=demo

# demo | real. demo uses in-process fixture adapters for every connector.
CONNECTOR_MODE=demo

# Generated by scripts/bootstrap-local-env.sh (matches docker-compose Postgres).
DATABASE_URL=
POSTGRES_PASSWORD=

REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Generated by scripts/bootstrap-local-env.sh — 32+ byte random values.
DEVICE_TOKEN_SIGNING_SECRET=
OAUTH_STATE_SIGNING_SECRET=
CONNECTOR_ENCRYPTION_MASTER_KEY=

# MinIO (exports and test fixtures only).
MINIO_ROOT_PASSWORD=

# --- Optional real integrations (leave empty to run in demo mode) ---
#
# GO LIVE WITH REAL SALESFORCE — exactly four edits (see docs/GO_LIVE.md):
#   1. MODEL_PROVIDER=anthropic   (above)
#   2. ANTHROPIC_API_KEY=...       (below)
#   3. CONNECTOR_MODE=real        (above)
#   4. SALESFORCE_CLIENT_ID / SALESFORCE_CLIENT_SECRET / SALESFORCE_REDIRECT_URI (below)
# Env validation fails fast if a pair is half-set (e.g. anthropic without a key,
# or a partial Salesforce triple), so a misconfigured trial won't start silently.

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# [2] Required when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFIER_MODEL=
ANTHROPIC_COMPILER_MODEL=

# [4] Salesforce Connected App — all three required together when CONNECTOR_MODE=real.
# REDIRECT_URI must match the Connected App callback exactly:
#   http://localhost:4000/v1/connectors/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=

# Google Sheets Connected App — client id + secret must be set together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OTEL_EXPORTER_OTLP_ENDPOINT=
