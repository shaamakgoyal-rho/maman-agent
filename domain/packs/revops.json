      "risk": "none",
      "on": []
    },
    {
      "id": "enrich",
      "risk": "low",
      "on": [
        "lead",
        "account",
        "contact"
      ]
    },
    {
      "id": "route_lead",
      "risk": "medium",
      "on": [
        "lead"
      ]
    },
    {
      "id": "update_crm_field",
      "risk": "medium",
      "on": [
        "lead",
        "opportunity",
        "account",
        "contact"
      ]
    },
    {
      "id": "advance_stage",
      "risk": "medium",
      "on": [
