{
  "$ref": "#/definitions/Recommendation",
  "definitions": {
    "Recommendation": {
      "type": "object",
      "properties": {
        "recommendation_id": {
          "type": "string",
          "format": "uuid"
        },
        "pattern_id": {
          "$ref": "#/definitions/Recommendation/properties/recommendation_id"
        },
        "owner_user_id": {
          "$ref": "#/definitions/Recommendation/properties/recommendation_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "properties": {
            "occurrence_count": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_day_count": {
              "type": "integer",
              "minimum": 0
            },
            "median_duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "redacted_steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "app": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  }
                },
                "required": [
                  "order",
                  "app",
                  "action"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "occurrence_count",
            "distinct_day_count",
            "median_duration_ms",
            "redacted_steps"
          ],
          "additionalProperties": false
        },
        "projected_minutes_saved_weekly": {
          "type": "number",
          "minimum": 0
        },
        "expected_cost_usd_low": {
          "type": "number",
          "minimum": 0
        },
        "expected_cost_usd_high": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "viewed",
            "snoozed",
            "dismissed",
            "blocked",
            "accepted"
          ]
        },
        "surfaced_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "created_at": {
          "$ref": "#/definitions/Recommendation/properties/surfaced_at"
        }
      },
      "required": [
        "recommendation_id",
        "pattern_id",
        "owner_user_id",
        "title",
        "summary",
        "evidence",
        "projected_minutes_saved_weekly",
        "expected_cost_usd_low",
        "expected_cost_usd_high",
        "confidence",
        "risk_level",
        "required_capabilities",
        "status",
        "created_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
