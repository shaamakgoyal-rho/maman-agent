          "$ref": "#/definitions/AgentRunInput/properties/run_id"
        },
        "agent_version_id": {
          "$ref": "#/definitions/AgentRunInput/properties/run_id"
        },
        "organization_id": {
          "$ref": "#/definitions/AgentRunInput/properties/run_id"
        },
