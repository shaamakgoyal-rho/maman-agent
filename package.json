{
  "name": "maman-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Maman \u2014 a desktop pet that notices repetitive work and builds safe helpers for you.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "demo": "bash scripts/demo.sh",
    "demo:reset": "bash scripts/demo-reset.sh",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @maman/db migrate",
    "db:rollback": "pnpm --filter @maman/db rollback",
    "db:seed": "pnpm --filter @maman/db seed",
    "db:reset-demo": "pnpm --filter @maman/db reset-demo",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:security": "turbo run test:security",
    "test:accessibility": "turbo run test:accessibility",
    "test:coverage": "turbo run test:coverage",
    "test:rust": "bash scripts/test-rust.sh",
    "test:swift": "bash scripts/test-swift.sh",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @maman/desktop tauri build",
    "build:extension": "pnpm --filter @maman/chrome-extension build",
    "openapi:generate": "pnpm --filter @maman/api openapi:generate",
    "openapi:check": "pnpm --filter @maman/api openapi:check",
    "schemas:generate": "pnpm --filter @maman/contracts schemas:generate",
    "schemas:check": "pnpm --filter @maman/contracts schemas:check",
    "packs:generate": "pnpm --filter @maman/domain-packs packs:generate",
    "packs:check": "pnpm --filter @maman/domain-packs packs:check",
    "packs:conformance": "pnpm --filter @maman/domain-packs packs:conformance",
    "packs:conformance:check": "pnpm --filter @maman/domain-packs packs:conformance:check",
    "audit:dependencies": "pnpm audit --audit-level high",
    "audit:licenses": "bash scripts/audit-licenses.sh",
    "audit:secrets": "bash scripts/audit-secrets.sh",
    "packs:date-conformance:check": "pnpm --filter @maman/domain-packs packs:date-conformance:check",
    "teach:egress-conformance": "pnpm --filter @maman/teach-mode egress-conformance",
    "teach:egress-conformance:check": "pnpm --filter @maman/teach-mode egress-conformance:check",
    "teach:vision-probe": "pnpm --filter @maman/teach-mode vision-probe"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25",
      "fast-uri@3": "^3.1.4",
      "fast-uri@4": "^4.1.1",
      "find-my-way@9": "^9.7.0",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.8",
      "sharp": "^0.35.3",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "3.3.18"
    }
  }
}
