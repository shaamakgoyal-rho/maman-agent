{
  "name": "@maman/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "build": "tsup src/main.ts --format esm --target node24 --out-dir dist --clean"
  },
  "dependencies": {
    "@maman/agent-runtime": "workspace:*",
    "@maman/capability-catalog": "workspace:*",
    "@maman/config": "workspace:*",
    "@maman/connector-auth": "workspace:*",
    "@maman/contracts": "workspace:*",
    "@maman/db": "workspace:*",
    "@maman/policy-engine": "workspace:*",
    "@maman/roi-engine": "workspace:*",
    "@temporalio/activity": "^1.11.5",
    "@temporalio/client": "^1.11.5",
    "@temporalio/worker": "^1.11.5",
    "@temporalio/workflow": "^1.11.5",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@maman/tsconfig": "workspace:*",
    "@temporalio/testing": "^1.11.5",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
